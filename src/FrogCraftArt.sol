    /// @dev The art, read from FrogCraftArtData's code.
    function _artBytes() private view returns (bytes memory art) {
        art = new bytes(ART_SIZE);
        address a = artData;
        assembly ("memory-safe") {
            extcodecopy(a, add(art, 32), 1, ART_SIZE)
        }
    }

    /// @notice Trait set `index` (0 to SUPPLY - 1), as 48 bits.
    function specOf(uint256 index) public view returns (uint256) {
        if (index >= SUPPLY) revert BadIndex();
        return specs.specOf(index);
    }

    /// @notice The NFT picture (an SVG) of trait set `index`.
    function render(uint256 index) external view returns (string memory) {
        uint256 v = specOf(index);
        return _card(_skin(v), _background(v));
    }

    /// @notice The picture shown before the reveal.
    function sealedSvg() external view returns (string memory) {
        return _card(_skin(SEALED), _background(SEALED));
    }

    /// @notice The traits as marketplaces list them: a JSON array of {"trait_type", "value"}.
    function attributes(uint256 index) external view returns (string memory) {
        uint256 v = specOf(index);
        bytes memory opts = OPTS;
        uint256 o;
        assembly ("memory-safe") {
            o := add(opts, 32)
        }
        bytes memory out;
        out = _pairs(out, o, BACKGROUND_BASE + ((v >> BACKGROUND_SHIFT) & BACKGROUND_MASK));
        out = _pairs(out, o, SKIN_BASE + ((v >> SKIN_SHIFT) & SKIN_MASK));
        out = _pairs(out, o, EYES_BASE + ((v >> EYES_SHIFT) & EYES_MASK));
        out = _pairs(out, o, MOUTH_BASE + ((v >> MOUTH_SHIFT) & MOUTH_MASK));
        out = _pairs(out, o, HAIR_BASE + ((v >> HAIR_SHIFT) & HAIR_MASK));
        out = _pairs(out, o, HAT_BASE + ((v >> HAT_SHIFT) & HAT_MASK));
        out = _pairs(out, o, EYEWEAR_BASE + ((v >> EYEWEAR_SHIFT) & EYEWEAR_MASK));
        out = _pairs(out, o, OUTFIT_BASE + ((v >> OUTFIT_SHIFT) & OUTFIT_MASK));
        out = _pairs(out, o, ACCESSORY_BASE + ((v >> ACCESSORY_SHIFT) & ACCESSORY_MASK));
        return string.concat("[", string(out), "]");
    }

    /// @notice Trait set `index`'s skin as RGBA bytes (64 x 64 x 4, row by row), as a PNG of it would hold: what a game
    ///         puts on the player.
    function skinPixels(uint256 index) external view returns (bytes memory rgba) {
        uint256 canvas = _skin(specOf(index));
        rgba = new bytes(16384);
        assembly ("memory-safe") {
            let out := add(rgba, 32)
            for { let i := 0 } lt(i, 4096) { i := add(i, 1) } {
                let c := mload(add(canvas, shl(5, i)))
                if c {
                    let p := add(out, shl(2, i))
                    mstore8(p, and(shr(16, c), 255))
                    mstore8(add(p, 1), and(shr(8, c), 255))
                    mstore8(add(p, 2), and(c, 255))
                    mstore8(add(p, 3), 255)
                }
            }
        }
    }

    /// @dev The skin: the frog in its colours, then each trait's layers in turn.
    function _skin(uint256 v) internal view returns (uint256 canvas) {
        uint256 data;
        (data, canvas) = _start();
        bytes memory opts = OPTS;
        uint256 o;
        assembly ("memory-safe") {
            o := add(opts, 32)
        }
        uint256 skin = data + 15 + 15 * ((v >> SKIN_SHIFT) & SKIN_MASK);
        _paintOption(data, canvas, o, 0, skin);
        _paintOption(data, canvas, o, OUTFIT_BASE + ((v >> OUTFIT_SHIFT) & OUTFIT_MASK), skin);
        _paintOption(data, canvas, o, EYES_BASE + ((v >> EYES_SHIFT) & EYES_MASK), skin);
        _paintOption(data, canvas, o, MOUTH_BASE + ((v >> MOUTH_SHIFT) & MOUTH_MASK), skin);
        _paintOption(data, canvas, o, HAIR_BASE + ((v >> HAIR_SHIFT) & HAIR_MASK), skin);
        _paintOption(data, canvas, o, HAT_BASE + ((v >> HAT_SHIFT) & HAT_MASK), skin);
        _paintOption(data, canvas, o, EYEWEAR_BASE + ((v >> EYEWEAR_SHIFT) & EYEWEAR_MASK), skin);
        _paintOption(data, canvas, o, ACCESSORY_BASE + ((v >> ACCESSORY_SHIFT) & ACCESSORY_MASK), skin);
    }

    function _background(uint256 v) private view returns (uint256 c) {
        bytes memory art = _artBytes();
        uint256 i = (v >> BACKGROUND_SHIFT) & BACKGROUND_MASK;
        assembly ("memory-safe") {
            c := shr(232, mload(add(add(art, 32), add(BG_OFFSET, mul(3, i)))))
        }
    }

    /// @dev Option `opt`'s layers, each in its palette.
    function _paintOption(uint256 data, uint256 canvas, uint256 o, uint256 opt, uint256 skin) private pure {
        uint256 rec;
        uint256 n;
        assembly ("memory-safe") {
            rec := add(o, shr(240, mload(add(o, shl(1, opt)))))
            n := byte(0, mload(rec))
        }
        for (uint256 k; k < n; ++k) {
            uint256 layer;
            uint256 palette;
            assembly ("memory-safe") {
                let w := mload(add(rec, add(1, mul(3, k))))
                layer := byte(0, w)
                palette := add(data, and(shr(232, w), 0xffff))
            }
            _paint(data, canvas, layer, palette, skin);
        }
    }

    /// @dev `out`, then option `opt`'s traits as JSON objects (with a comma before each but the first).
    function _pairs(bytes memory out, uint256 o, uint256 opt) private pure returns (bytes memory) {
        uint256 rec;
        uint256 n;
        assembly ("memory-safe") {
            rec := add(o, shr(240, mload(add(o, shl(1, opt)))))
            rec := add(rec, add(1, mul(3, byte(0, mload(rec)))))
            n := byte(0, mload(rec))
        }
        bytes memory names = NAMES;
        bytes memory ends = NAME_ENDS;
        for (uint256 k; k < n; ++k) {
            uint256 t;
            uint256 val;
            assembly ("memory-safe") {
                let w := mload(add(rec, add(1, shl(1, k))))
                t := byte(0, w)
                val := byte(1, w)
            }
            out = abi.encodePacked(
                out, out.length == 0 ? "" : ",", '{"trait_type":"', _name(names, ends, t), '","value":"', _name(names, ends, val), '"}'
            );
        }
        return out;
    }

    /// @dev The art in memory (where its bytes start), and a canvas of 4,096 empty pixels.
    function _start() private view returns (uint256 data, uint256 canvas) {
        bytes memory art = _artBytes();
        assembly ("memory-safe") {
            data := add(art, 32)
            canvas := mload(0x40)
            calldatacopy(canvas, calldatasize(), 131072) // (zeros)
            mstore(0x40, add(canvas, 131072))
        }
    }

    /// @dev paint() in I'M DEGEN's web/degen-skin.js: layer `layer`'s rectangles, each in its colour (`colours`, then `skin`, then
    ///      the fixed ones; "clear" empties the pixels).
    function _paint(uint256 data, uint256 canvas, uint256 layer, uint256 colours, uint256 skin) private pure {
        assembly ("memory-safe") {
            let rec := mload(add(data, add(198, shl(2, layer))))
            let p := add(data, shr(240, rec))
            let end := add(p, shl(2, and(shr(224, rec), 0xffff)))
            for {} lt(p, end) { p := add(p, 4) } {
                let e := shr(224, mload(p))
                let code := and(shr(5, e), 31)
                let c := 0
                switch lt(code, 9)
                case 1 { c := or(0x1000000, shr(232, mload(add(colours, mul(3, code))))) }
                default {
                    switch lt(code, 14)
                    case 1 { c := or(0x1000000, shr(232, mload(add(skin, mul(3, sub(code, 9)))))) }
                    default {
                        if lt(code, 19) { c := or(0x1000000, shr(232, mload(add(data, add(0, mul(3, sub(code, 14))))))) }
                    }
                }
                let width := shl(5, add(and(shr(14, e), 63), 1))
                let row := add(canvas, shl(5, add(shl(6, and(shr(20, e), 63)), shr(26, e))))
                for { let h := add(and(shr(10, e), 15), 1) } h { h := sub(h, 1) } {
                    for { let q := row let qEnd := add(row, width) } lt(q, qEnd) { q := add(q, 32) } { mstore(q, c) }
                    row := add(row, 2048)
                }
            }
        }
    }

